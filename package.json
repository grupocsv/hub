{
  "name": "hub-grupocsv",
  "version": "1.0.0",
  "description": "Hub Central do Grupo CSV - Portal unificado do ecossistema AxiaCare®, MedValor®, Thera®",
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "npm run compass:publish && npm run compass:catalog && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "compass:publish": "node scripts/compass-v2/publish-editions.mjs --source compass/edicoes/2026 --output docs/compass/edicoes/2026",
    "compass:catalog": "node scripts/compass-v2/catalog.mjs --source compass/edicoes/2026 --output docs/compass/catalog.json",
    "compass:test": "node --test tests/compass-v2/*.test.mjs",
    "compass:build": "npm run compass:catalog && npm run compass:test && npm run docs:build",
    "compass:pdf": "node scripts/compass-v2/render-pdf.mjs",
    "compass:quality": "node scripts/compass-v2/quality-gates.mjs",
    "compass:pdf:runtime": "bash scripts/compass-v2/pdf-runtime.sh",
    "compass:test:pdf": "npm run compass:pdf:runtime -- node --test tests/compass-v2/pdf.integration.mjs",
    "compass:verify": "npm run compass:test && npm run compass:test:pdf",
    "documentos:vendor": "node scripts/vendor-documentos-pdfjs.mjs",
    "documentos:generate": "npm run documentos:vendor && node scripts/generate-documentos-config.mjs",
    "documentos:test": "npm run documentos:vendor && node --test tests/documentos/*.test.mjs tests/hub-auth-corporate.test.mjs",
    "documentos:e2e": "playwright test --config=playwright.documentos.config.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grupocsv/hub.git"
  },
  "author": "Grupo CSV",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "pdfjs-dist": "6.2.108",
    "vitepress": "2.0.0-alpha.17",
    "yaml": "^2.8.1"
  },
  "overrides": {
    "vite": "7.3.6"
  }
}
